APP_NAME=SparringScope
DATABASE_URL=postgresql+psycopg://sparringscope:local_dev_only@localhost:5432/sparringscope
ADMIN_TOKEN=replace-this-with-a-long-random-secret
# Set this to the time you first publish the Instagram Story (UTC ISO-8601).
# Example: 2026-11-07T12:30:00+00:00
STORY_PUBLISHED_AT=
# Optional MaxMind GeoLite2 City database path. Without it, area is recorded as unknown.
MAXMIND_DB_PATH=
# Only enable forwarded IP handling behind a reverse proxy you control.
TRUST_PROXY_HEADERS=false
